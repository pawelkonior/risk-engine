# Two Vercel projects: this backend uses Root Directory api, frontend uses web.
APP_ENVIRONMENT=production
APP_DOCS_ENABLED=false
# For example Neon Free. Use the provider's pooled URL here.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-POSTGRES-HOST/app?sslmode=require
APP_DATABASE_POOL_MODE=null
# Optionally set DIRECT_DATABASE_URL to the direct URL for migrations.
APP_CORS_ALLOWED_ORIGINS=["https://YOUR-FRONTEND.vercel.app"]
APP_AI_ENABLED=true
# Cloudflare Workers AI Free quota; use your account ID, API token and a free model.
APP_AI_CHAT_PROVIDER=openai_compatible
APP_AI_CHAT_BASE_URL=https://api.cloudflare.com/client/v4/accounts/YOUR-ACCOUNT-ID/ai/v1
APP_AI_CHAT_API_KEY=REPLACE_WITH_CLOUDFLARE_API_TOKEN
APP_AI_CHAT_MODEL=@cf/meta/llama-3.1-8b-instruct
# Qdrant Cloud Free with Cloud Inference. Never mix with local Ollama embeddings.
APP_AI_EMBEDDING_PROVIDER=qdrant_cloud
APP_AI_EMBEDDING_MODEL=intfloat/multilingual-e5-small
APP_AI_EMBEDDING_DIMENSIONS=384
APP_AI_QDRANT_URL=https://YOUR-CLUSTER.cloud.qdrant.io
APP_AI_QDRANT_API_KEY=REPLACE_WITH_QDRANT_API_KEY
APP_AI_QDRANT_COLLECTION=app_chunks_cloud_e5_v1
# Neo4j AuraDB Free: one database with both logical graphs.
APP_AI_NEO4J_URI=neo4j+s://YOUR-INSTANCE.databases.neo4j.io
APP_AI_NEO4J_USERNAME=neo4j
APP_AI_NEO4J_PASSWORD=REPLACE_WITH_NEO4J_PASSWORD
APP_AI_NEO4J_DATABASE=neo4j
APP_AI_REQUEST_TIMEOUT_SECONDS=45
# These are defense in depth; the code explicitly disables LangSmith tracing.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false

# Langfuse Cloud Hobby or your externally hosted Langfuse v4 instance.
APP_LANGFUSE_ENABLED=true
APP_LANGFUSE_BASE_URL=https://cloud.langfuse.com
APP_LANGFUSE_PUBLIC_KEY=REPLACE_WITH_LANGFUSE_PUBLIC_KEY
APP_LANGFUSE_SECRET_KEY=REPLACE_WITH_LANGFUSE_SECRET_KEY
APP_LANGFUSE_CAPTURE_CONTENT=false
APP_LANGFUSE_TIMEOUT_SECONDS=3
