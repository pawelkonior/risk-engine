# Runtime (APP_ typos are rejected)
APP_NAME=Application API
APP_VERSION=0.1.0
APP_ENVIRONMENT=local
APP_LOG_LEVEL=INFO

# HTTP. Origins must be JSON, e.g. ["http://localhost:3000"]
APP_DOCS_ENABLED=true
APP_CORS_ALLOWED_ORIGINS=[]
APP_CORS_ALLOW_CREDENTIALS=false
APP_REQUEST_BODY_MAX_BYTES=1048576

# Persistence is required. Local SQLite needs no service.
APP_DATABASE_URL=sqlite+aiosqlite:///./app.db
# PostgreSQL alternative (DATABASE_URL is also accepted):
# APP_DATABASE_URL=postgresql+psycopg://app:app-local-only@127.0.0.1:5432/app
# Set null for Vercel / external transaction poolers; queue for a persistent server.
APP_DATABASE_POOL_MODE=queue
APP_DATABASE_POOL_SIZE=5
APP_DATABASE_MAX_OVERFLOW=5
APP_DATABASE_POOL_TIMEOUT_SECONDS=5
APP_DATABASE_CONNECT_TIMEOUT_SECONDS=5
# Optional direct PostgreSQL URL used only by Alembic:
# APP_DATABASE_MIGRATION_URL=postgresql+psycopg://user:password@host:5432/app?sslmode=require

# AI endpoints are opt-in for a bare local API. The root Compose enables them.
APP_AI_ENABLED=false
APP_AI_CHAT_PROVIDER=ollama
APP_AI_CHAT_MODEL=qwen3:0.6b
APP_AI_OLLAMA_BASE_URL=http://127.0.0.1:11434
APP_AI_EMBEDDING_PROVIDER=ollama
APP_AI_EMBEDDING_MODEL=embeddinggemma
APP_AI_EMBEDDING_DIMENSIONS=768
APP_AI_QDRANT_URL=http://127.0.0.1:6333
APP_AI_QDRANT_COLLECTION=app_chunks_ollama_v1
APP_AI_NEO4J_URI=bolt://127.0.0.1:7687
APP_AI_NEO4J_USERNAME=neo4j
APP_AI_NEO4J_PASSWORD=neo4j-local-only
APP_AI_NEO4J_DATABASE=neo4j
APP_AI_HTTP_TIMEOUT_SECONDS=40
APP_AI_REQUEST_TIMEOUT_SECONDS=45

# Explicit AI observability. Root Compose enables its local Langfuse instance.
APP_LANGFUSE_ENABLED=false
APP_LANGFUSE_BASE_URL=http://127.0.0.1:3000
# APP_LANGFUSE_PUBLIC_KEY=pk-lf-template-local
# APP_LANGFUSE_SECRET_KEY=sk-lf-template-local
# Enable only when prompts, source content, and responses may be recorded.
APP_LANGFUSE_CAPTURE_CONTENT=false
APP_LANGFUSE_TIMEOUT_SECONDS=3
